# Compilador
CC = clang

# Caminhos de include e lib (Apple Silicon)
INCLUDE_PATH = -I/opt/homebrew/include
LIB_PATH = -L/opt/homebrew/lib

# Raylib e frameworks macOS
LIBS = -lraylib -framework OpenGL -framework Cocoa -framework IOKit -framework CoreVideo

# Executável
TARGET = main

# Arquivos fonte
SRC = $(shell find . -name "*.c")

# Regra padrão
all:
	$(CC) $(SRC) -o $(TARGET) $(INCLUDE_PATH) $(LIB_PATH) $(LIBS)

# Rodar o programa
run: all
	./$(TARGET)

# Limpar binários
clean:
	rm -f $(TARGET)